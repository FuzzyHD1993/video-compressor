# Порт (по умолчанию 8095)
PORT=8095

# Адрес: 127.0.0.1 = только локально, 0.0.0.0 = доступ из сети
BIND_ADDR=127.0.0.1

# Basic Auth. Пусто = без пароля (для localhost).
# Формат: {SHA256}<hex SHA-256 от пароля>
# Пример: printf '%s' 'secret' | sha256sum
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=

# Энкодер: пусто = авто (NVENC -> QSV -> AMF -> CPU)
ENCODER=
FORCE_CPU=

# Количество параллельных задач (пусто = авто)
MAX_WORKERS=

# Не открывать браузер (1 = не открывать)
NO_BROWSER=
